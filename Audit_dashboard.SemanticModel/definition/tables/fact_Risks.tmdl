		lineageTag: c4d5f136-efc5-412d-821a-75730d8db868

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure FraudRate_AI_Yes =
			
			CALCULATE(DIVIDE(SUM('fact_Risks'[Fraud_Cases_Detected]), SUM('fact_Risks'[Total_Audit_Engagements]),0), 'fact_Risks'[AI_Used_for_Auditing] = "Yes")
		lineageTag: 78ce1c53-22e8-4d77-a87f-fddf26e5c9be

