table fact_Risks
	lineageTag: f539ffd0-8bcb-49eb-bff5-21f2c6e781bb

	measure TotalAuditEngagements = SUM('fact_Risks'[Total_Audit_Engagements])
		formatString: 0
		lineageTag: b700a261-76c5-48b9-83fc-322d659fa0e4

	measure 'Total Fraud Cases' = SUM('fact_Risks'[Fraud_Cases_Detected])
		formatString: 0
		lineageTag: 4bcdcf66-c257-424e-a93e-67b13d4cbd25

	measure 'Avg Audit Effectiveness' = AVERAGE('fact_Risks'[Audit_Effectiveness_Score])
		lineageTag: 86359550-74d0-4c9e-9e8a-5faf7c350c46

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Fraud Cases' = SUM(fact_Risks[Fraud_Cases_Detected])
		formatString: 0
		lineageTag: acf32f44-be7a-4a4d-8deb-c51ea2124696

	measure 'Compliance Violations' = SUM(fact_Risks[Compliance_Violations])
		formatString: 0
		lineageTag: 75731b67-3a48-48fa-9511-7c30afe78bd3

	measure 'Avg Client Satisfaction' = AVERAGE(fact_Risks[Client_Satisfaction_Score])
		lineageTag: 4f32b254-b5cd-49c6-94cb-2bb400f02033

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue Impact' = SUM(fact_Risks[Total_Revenue_Impact])
		lineageTag: 32b627ad-2d67-4e06-bd4f-b49bd830960b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Engagements' = SUM(fact_Risks[Total_Audit_Engagements])
		formatString: 0
		lineageTag: 33282130-d686-4498-8c60-fefb96bb01d5

	measure 'High Risk %' = DIVIDE(SUM(fact_Risks[High_Risk_Cases]), SUM(fact_Risks[Total_Audit_Engagements]))
		lineageTag: f6c9fc9c-0266-47ca-aae3-1769e456432b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Fraud Rate' =
			
			DIVIDE(
			    SUM('fact_Risks'[Fraud_Cases_Detected]),
			    SUM('fact_Risks'[Total_Audit_Engagements]),
			    0
			)
		lineageTag: 66d5f7e4-3916-4d4a-a052-2004b70845e5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Compliance Rate' =
			
			DIVIDE(
			    SUM('fact_Risks'[Compliance_Violations]),
			    SUM('fact_Risks'[Total_Audit_Engagements]),
			    0
			)
		lineageTag: fc487936-343c-44e5-8f02-ddafaffa91e5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue Impact per Engagement' =
			
			DIVIDE([Revenue Impact], [Total Engagements], 0)
		lineageTag: 81537fee-847d-4048-89d5-f5effb2b1d2d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Engagements per Employee' =
			
			DIVIDE(
			    SUM('fact_Risks'[Total_Audit_Engagements]),
			    SUM('fact_Risks'[Employee_Workload]),
			    0
			)
		lineageTag: 8da71d23-e83a-4e53-b06d-40ff49978a3e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure FirmRiskRank =
			
			RANKX(ALL(dim_Firm[Firm_Name]), [High Risk %], , DESC, DENSE)
		formatString: 0
		lineageTag: da48ea71-4e30-4c79-8c54-c3186917fbce

	measure 'Top Firm By Audit Effectiveness' =
			
			VAR TopTable =
			    TOPN(
			        1,
			        ADDCOLUMNS(
			            VALUES(dim_Firm[Firm_Name]),
			            "AvgEff", [Avg Audit Effectiveness]
			        ),
			        [AvgEff],
			        DESC
			    )
			RETURN
			    CONCATENATEX(TopTable, dim_Firm[Firm_Name], ", ")
		lineageTag: f34deb2b-f44e-4ede-9358-d0bf0b5cbaec

	measure 'Top Firm By Client Satisfaction' =
			
			VAR TopTable =
			    TOPN(
			        1,
			        ADDCOLUMNS(
			            VALUES(dim_Firm[Firm_Name]),
			            "AvgCS", [Avg Client Satisfaction]
			        ),
			        [AvgCS],
			        DESC
			    )
			RETURN
			    CONCATENATEX(TopTable, dim_Firm[Firm_Name], ", ")
		lineageTag: 29d51c0e-fe03-4857-a87e-7caf9a2fdc52

	measure 'Avg Audit Effectiveness YoY' =
			
			VAR CurrYear = MAX(dim_Date[Year])
			VAR PrevYear = CurrYear - 1
			VAR CurrVal = CALCULATE([Avg Audit Effectiveness], FILTER(ALL(dim_Date), dim_Date[Year] = CurrYear))
			VAR PrevVal = CALCULATE([Avg Audit Effectiveness], FILTER(ALL(dim_Date), dim_Date[Year] = PrevYear))
			RETURN
			IF(PrevVal = 0, BLANK(), (CurrVal - PrevVal) / PrevVal)
		lineageTag: 729bc73a-950d-4d61-82c7-78a6d750a49c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure IndustryRevenueImpact = SUM('fact_Risks'[Total_Revenue_Impact])
		lineageTag: 45db0b62-a928-42c0-a9b0-e44dbe7c5563

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure RevenueImpactPerEngagement =
			
			DIVIDE(
			    SUM('fact_Risks'[Total_Revenue_Impact]),
			    SUM('fact_Risks'[Total_Audit_Engagements]),
			    0
			)
		lineageTag: a6e2c07e-161f-463f-8466-577abe71946d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure IndustryRevenueShare =
			
			DIVIDE(
			    SUM('fact_Risks'[Total_Revenue_Impact]),
			    CALCULATE(SUM('fact_Risks'[Total_Revenue_Impact]), ALL(dim_Industry[Industry_Affected])),
			    0
			)
		lineageTag: 772a4a51-e58b-4e29-a7c5-5bda1cdb6e1a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Industry High Risk Pct' =
			
			DIVIDE(
			    SUM('fact_Risks'[High_Risk_Cases]),
			    SUM('fact_Risks'[Total_Audit_Engagements]),
			    0
			)
		lineageTag: 01edf16e-af7e-48d7-9d06-8c507cdb15ab

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Industry Fraud Rate' = ```
			
			DIVIDE(
			    SUM('fact_Risks'[Fraud_Cases_Detected]),
			    SUM('fact_Risks'[Total_Audit_Engagements]),
			    0
			)
			
			```
		lineageTag: 7a80e827-9b4a-462b-a91b-afc077e718fa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure IndustryAvgAuditEffectiveness = AVERAGE('fact_Risks'[Audit_Effectiveness_Score])
		lineageTag: bb4ba714-268f-4f2c-b088-ccca8be2f87e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure IndustryAvgClientSatisfaction = AVERAGE('fact_Risks'[Client_Satisfaction_Score])
		lineageTag: 605cef7b-ebde-4ccf-a2bf-9e606948b722

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Engagements_AI_Yes =
			
			CALCULATE(
			    SUM('fact_Risks'[Total_Audit_Engagements]),
			    'fact_Risks'[AI_Used_for_Auditing] = "Yes"
			)
		formatString: 0
		lineageTag: 7cece6c1-0d20-41e0-86e6-612b42faf4f0

	measure Engagements_AI_No =
			
			CALCULATE(
			    SUM('fact_Risks'[Total_Audit_Engagements]),
			    'fact_Risks'[AI_Used_for_Auditing] = "No"
			)
		formatString: 0
		lineageTag: 8ccf7598-4a4a-4a93-a02c-498200e85778

	measure 'AI Adoption Rate' =
			
			DIVIDE( [Engagements_AI_Yes], [Total Engagements], 0 )
		lineageTag: be069f4d-cef8-4def-8741-6ec86ab8656c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Effectiveness of AI Use' = ```
			CALCULATE( [Avg Audit Effectiveness], 'fact_Risks'[AI_Used_for_Auditing] = "Yes" ) 
			```
		lineageTag: e5603d2d-38d9-4fcd-9459-f0bf7ef04975

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure AvgEffectiveness_AI_No = ```
			
			CALCULATE( [Avg Audit Effectiveness], 'fact_Risks'[AI_Used_for_Auditing] = "No" )
			
			```
		lineageTag: 4e33c53f-699a-49e7-adfd-70782837792b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Delta Effectiveness AI' =
			
			[Avg Effectiveness of AI Use] - [AvgEffectiveness_AI_No]
		lineageTag: 16abacaf-716a-4a57-9111-d976f8fd8acc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Satisfaction of AI Use' =
			
